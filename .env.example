# Variáveis de ambiente do projeto
# Copie para .env.local e preencha

# GitHub REST API v3 — usado pela API Route /api/github para buscar os
# repositórios exibidos na seção de Projetos. Gere um token com escopo
# público (read-only) em https://github.com/settings/tokens
GITHUB_TOKEN=

# Usuário/organização do GitHub cujos repositórios serão exibidos
GITHUB_USERNAME=

# Resend — usado pela API Route /api/contact para enviar e-mails do
# formulário de contato. Crie uma chave em https://resend.com/api-keys
RESEND_API_KEY=

# E-mail de destino das mensagens do formulário de contato
CONTACT_EMAIL_TO=

# URL pública do site em produção (sem barra no final). Usada para
# gerar URLs absolutas nas meta tags de SEO (hreflang, Open Graph).
# Sem domínio ainda? Deixe em branco — cai no fallback localhost:3000.
NEXT_PUBLIC_SITE_URL=
